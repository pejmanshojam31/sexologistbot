# Copy this file to .env and fill in real values. Never commit .env to git.

# Summarizer backend. Only the one named by `summarizer:` in
# config/settings.yaml is actually needed.
# You.com Research API (default) -- key from https://api.you.com
YOU_API_KEY=ydc-sk-...
# Anthropic API -- key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Get from @BotFather on Telegram (create a bot, then add it as admin to your channel)
TELEGRAM_BOT_TOKEN=123456789:AA...

# Your channel's @username (if public) or numeric chat id (if private, starts with -100...)
TELEGRAM_CHANNEL_ID=@your_channel_name

# Optional: NCBI API key raises PubMed rate limits from 3/sec to 10/sec. Free at
# https://www.ncbi.nlm.nih.gov/account/settings/ -> API Key Management
NCBI_API_KEY=

# Optional, only needed if you want auto-publishing to a WordPress blog instead of
# (or in addition to) local markdown files. Use an Application Password, not your
# main password: WordPress Admin -> Users -> Profile -> Application Passwords.
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
